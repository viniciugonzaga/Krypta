{
  "name": "krypta",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"vite\"",
    "dev:front": "vite",
    "dev:back": "npm run dev --prefix server",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "tauri": "tauri",
    "desktop:dev": "concurrently -n api,app \"npm run dev:back\" \"tauri dev\"",
    "desktop:build": "tauri build",
    "desktop:icon": "tauri icon src-tauri/app-icon.png",
    "desktop:lancar": "node scripts/lancar-versao.mjs",
    "desktop:copiar": "node scripts/copiar-instalador.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-oauth/google": "^0.13.5",
    "axios": "^1.20.0",
    "framer-motion": "^13.3.0",
    "google-auth-library": "^11.3.2",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
