# ============================================================
# KRYPTA — .env do APP DESKTOP (Tauri)
# Copie para ".env.desktop". É lido só pelo "npm run desktop:build"
# (vite build --mode desktop) e vale por cima do .env.
#
# O app desktop usa o MESMO servidor e o MESMO banco do site.
# ============================================================

# Para testar no seu PC (o servidor precisa estar ligado neste PC):
VITE_API_URL=http://localhost:3333/api
# Depois da hospedagem (Hostinger), troque pelo endereço público da API:
# VITE_API_URL=https://api.seudominio.com.br/api

# Endereço do site (o kit de herança gerado no app usa este link)
# VITE_SITE_URL=https://seudominio.com.br
VITE_SITE_URL=
