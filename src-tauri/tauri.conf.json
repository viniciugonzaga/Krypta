{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Krypta",
  "version": "../package.json",
  "identifier": "com.krypta.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:front",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Krypta",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#07010f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Krypta",
    "category": "Utility",
    "shortDescription": "Cofre de senhas zero-knowledge",
    "longDescription": "Krypta: suas senhas cifradas no seu dispositivo, com herança digital, Kill Switch e o mesmo cofre do site.",
    "copyright": "© Krypta",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
