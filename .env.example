# Copie para .env e preencha com seus valores locais
DATABASE_URL=postgres://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO
JWT_SECRET=gere_com_crypto_randomBytes_32_hex

# So desenvolvimento: multiplica os limites de requisicao (ignorado com NODE_ENV=production)
# RATE_LIMIT_MULT=20

# Origens do portal web liberadas no CORS, separadas por virgula (vazio = nenhuma)
CORS_ORIGINS=
# Numero de proxies reversos confiaveis a frente da API (vazio = nenhum)
TRUST_PROXY=

# Email (aviso de inatividade, Kill Switch e heranca). Sem SMTP_HOST/SMTP_FROM o envio fica desativado
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Krypta <nao-responder@seudominio.com>
# Fora de producao so envia para estes enderecos (separados por virgula)
SMTP_ONLY_TO=
