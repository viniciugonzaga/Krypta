# ============================================================
# KRYPTA — .env do FRONT (raiz do projeto, ao lado do package.json)
# Copie para ".env" (desenvolvimento) ou ".env.production" (build).
#
# ⚠️ Tudo que começa com VITE_ vai parar no navegador: NUNCA coloque
#    segredos aqui (senhas, CLIENT_SECRET, JWT_SECRET...).
# ============================================================

# Endereço da API
#   Desenvolvimento:  http://localhost:3333/api
#   Produção:         https://api.seudominio.com.br/api
VITE_API_URL=http://localhost:3333/api

# Login social (deixe desligado até configurar as chaves)
VITE_SOCIAL_LOGIN_ENABLED=false
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
