# ============================================================
# KRYPTA — server/.env  (copie este arquivo para ".env" e preencha)
# NUNCA suba o .env para o GitHub (já está no .gitignore).
# ============================================================

# ============ SERVIDOR ============
PORT=3333
NODE_ENV=development

# ============ BANCO DE DADOS (MySQL do XAMPP / Hostinger) ============
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=krypta

# ============ TOKENS ============
# Gere cada segredo com:  npm run gerar-segredo
JWT_SECRET=cole_aqui_um_segredo_gerado
JWT_EXPIRES_IN=24h
REFRESH_EXPIRES_IN_DAYS=7
# Token do dispositivo (login por hardware). O contrato da API usa 15 min.
HARDWARE_TOKEN_EXPIRES_IN=15m

# ============ COFRE ============
# Segredo aplicado antes do bcrypt nas provas de contingência (CCP/CCH).
# OBRIGATÓRIO, 64+ caracteres hex e DIFERENTE do JWT_SECRET.
# Gere com:  npm run gerar-segredo
# GUARDE UMA CÓPIA FORA DO PROJETO: se perder, todas as provas param de funcionar.
PASSWORD_PEPPER=

# ============ REDE ============
# Origens liberadas (separe por vírgula). Produção, por exemplo:
# CORS_ORIGIN=https://app.seudominio.com.br
CORS_ORIGIN=http://localhost:5173
# Proxies na frente da API (local = 0 · Hostinger = 1)
TRUST_PROXY=0
# Só em desenvolvimento: multiplica o limite de tentativas (para testes repetidos)
RATE_LIMIT_MULT=1

# ============ E-MAIL ============
# Deixe SMTP_USER e SMTP_PASS VAZIOS para desligar o envio (desenvolvimento).
# Sem e-mail, a rotina de inatividade nunca exclui contas.
# Gmail: use uma "senha de app" de 16 letras, sem espaços.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Krypta <no-reply@krypta.local>
# Só em desenvolvimento: se preenchido, SÓ estes e-mails recebem mensagens
# (separados por vírgula). Ex.: SMTP_ONLY_TO=seuemail@gmail.com
SMTP_ONLY_TO=

# ============ LOGIN SOCIAL (deixe vazio por enquanto) ============
GOOGLE_CLIENT_ID=
